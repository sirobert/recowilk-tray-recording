<Application x:Class="MeetingAudioRecorder.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <tb:TaskbarIcon x:Key="TrayIcon" Visibility="Visible" ToolTipText="Recorder"
                        MenuActivation="RightClick" DoubleClickCommand="{Binding OpenSettingsCommand}">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <ContextMenu.Resources>
                        <Style TargetType="MenuItem">
                            <Setter Property="HeaderTemplate">
                                <Setter.Value><DataTemplate><TextBlock Text="{Binding}" MaxWidth="460" TextTrimming="CharacterEllipsis"/></DataTemplate></Setter.Value>
                            </Setter>
                            <Setter Property="ToolTip" Value="{Binding Header, RelativeSource={RelativeSource Self}}"/>
                            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                        </Style>
                    </ContextMenu.Resources>
                    <MenuItem Header="{Binding Activity.RecordingText}" IsEnabled="False" FontWeight="Bold"/>
                    <MenuItem Header="Rozpocznij nagrywanie" Command="{Binding StartRecordingCommand}" IsEnabled="{Binding CanStart}"/>
                    <MenuItem Header="Zatrzymaj nagrywanie" Command="{Binding StopRecordingCommand}" IsEnabled="{Binding CanStop}"/>
                    <MenuItem Header="Lista nagrań" Command="{Binding OpenRecordingsCommand}"/>
                    <MenuItem Header="Otwórz folder nagrań" Command="{Binding OpenRecordingsFolderCommand}"/>
                    <MenuItem Header="Pokaż ostatnie nagranie" Command="{Binding ShowLastRecordingCommand}"/>
                    <Separator/>
                    <MenuItem Header="{Binding Activity.TranslationText}" IsEnabled="False" FontWeight="Bold"/>
                    <MenuItem Header="{Binding Translation.MenuText}" Command="{Binding Translation.ToggleCommand}"/>
                    <MenuItem Header="Pokaż napisy" Command="{Binding Translation.ShowCommand}"/>
                    <MenuItem Header="Historia tłumaczeń" Command="{Binding Translation.OpenHistoryCommand}"/>
                    <MenuItem Header="Ustawienia tłumaczenia" Command="{Binding Translation.OpenSettingsCommand}"/>
                    <Separator/>
                    <MenuItem Header="{Binding Activity.UploadText}" IsEnabled="False" FontWeight="Bold"/>
                    <MenuItem Header="Kolejka i błędy eksportu" Command="{Binding OpenRecordingsCommand}"/>
                    <Separator/>
                    <MenuItem Header="Aplikacja" IsEnabled="False" FontWeight="Bold"/>
                    <MenuItem Header="Ustawienia" Command="{Binding OpenSettingsCommand}"/>
                    <MenuItem Header="Zakończ aplikację" Command="{Binding ExitCommand}"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Application.Resources>
</Application>
