<Window x:Class="MeetingAudioRecorder.App.Views.ConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Informacja o nagrywaniu"
        Height="360" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F7FA">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Rozumiem" IsDefault="True" Padding="16,8" MinWidth="120" Click="Accept_Click"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Text="Meeting Audio Recorder" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Ta aplikacja nagrywa dźwięk z wybranego mikrofonu oraz dźwięk odtwarzany na wybranym urządzeniu wyjściowym (np. słuchawkach)."/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Nagrywanie jest widoczne na ikonie w zasobniku systemowym. Aplikacja działa wyłącznie lokalnie i nie wysyła nagrań do Internetu."/>
            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"
                       Text="Jesteś odpowiedzialny/a za poinformowanie uczestników spotkania i uzyskanie wymaganych zgód na nagrywanie rozmowy."/>
            <TextBlock TextWrapping="Wrap" Foreground="#555"
                       Text="Kontynuując, potwierdzasz, że rozumiesz te zasady."/>
        </StackPanel>
    </DockPanel>
</Window>
