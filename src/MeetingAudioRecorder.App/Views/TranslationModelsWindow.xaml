<Window x:Class="MeetingAudioRecorder.App.Views.TranslationModelsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Przygotowanie tłumacza" Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
 <StackPanel Margin="24">
  <TextBlock Text="Modele do tłumaczenia lokalnego" FontSize="20" FontWeight="SemiBold"/>
  <TextBlock x:Name="Description" TextWrapping="Wrap" Margin="0,16,0,10"/>
  <TextBlock x:Name="Location" TextWrapping="Wrap" Foreground="#566"/>
  <ProgressBar x:Name="Progress" Height="14" Minimum="0" Maximum="100" Margin="0,20,0,10"/>
  <TextBlock x:Name="Status" Text="Gotowe do rozpoczęcia." TextWrapping="Wrap"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
   <Button x:Name="StartButton" Content="Pobierz / sprawdź modele" Click="Start" Padding="12,8"/>
   <Button x:Name="CancelButton" Content="Anuluj" Click="Cancel" Padding="12,8" Margin="10,0,0,0"/>
  </StackPanel>
 </StackPanel>
</Window>
