<Window x:Class="MeetingAudioRecorder.App.Views.RecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Odzyskiwanie nagrań"
        Height="400" Width="560"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Znaleziono niedokończone nagrania (np. po awarii). Możesz je odzyskać, otworzyć folder tymczasowy lub usunąć pliki. Pliki nie są usuwane automatycznie."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Odzyskaj wybrane" Padding="12,6" Margin="4" Click="Recover_Click"/>
            <Button Content="Otwórz folder Temp" Padding="12,6" Margin="4" Click="OpenFolder_Click"/>
            <Button Content="Usuń wybrane" Padding="12,6" Margin="4" Click="Delete_Click"/>
            <Button Content="Zamknij" Padding="12,6" Margin="4" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
        <ListBox x:Name="List" DisplayMemberPath="Display" SelectionMode="Single"/>
    </DockPanel>
</Window>
