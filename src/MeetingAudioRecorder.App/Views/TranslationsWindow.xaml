<Window x:Class="MeetingAudioRecorder.App.Views.TranslationsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Tłumaczenia live — historia lokalna" Width="1140" Height="700" MinWidth="760" MinHeight="460" Background="#F5F7FA" WindowStartupLocation="CenterScreen">
 <DockPanel Margin="18">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="Tłumaczenia live" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Zapis lokalny · angielski oryginał i polskie tłumaczenie · bez wysyłania" Foreground="#566" Margin="0,4,0,12"/>
   <DockPanel><Button DockPanel.Dock="Right" Content="Odśwież" Click="Refresh" Padding="12,5" Margin="8,0,0,0"/><TextBox x:Name="Search" TextChanged="SearchChanged" ToolTip="Szukaj w tytule sesji oraz treści otwartego tłumaczenia" Padding="6"/></DockPanel>
  </StackPanel>
  <TextBlock x:Name="Status" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,10,0,0"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <DockPanel><TextBox DockPanel.Dock="Top" x:Name="SessionSearch" TextChanged="SessionSearchChanged" ToolTip="Szukaj sesji po tytule" Padding="6" Margin="0,0,0,8"/>
    <ListBox x:Name="Sessions" SelectionChanged="SelectedSession" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" Padding="4"/></DataTemplate></ListBox.ItemTemplate></ListBox>
   </DockPanel>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <TextBlock x:Name="TitleText" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <DataGrid Grid.Row="1" x:Name="Captions" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True" HeadersVisibility="Column" ClipboardCopyMode="IncludeHeader" SelectionUnit="CellOrRowHeader">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Czas / źródło" Binding="{Binding Label}" Width="125"/>
      <DataGridTextColumn Header="Angielski — oryginał" Binding="{Binding English}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="5"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
      <DataGridTextColumn Header="Polski — tłumaczenie" Binding="{Binding Polish}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="5"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
     </DataGrid.Columns>
    </DataGrid>
   </Grid>
  </Grid>
 </DockPanel>
</Window>
