<Window x:Class="MeetingAudioRecorder.App.Views.TranslationSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ustawienia — tłumaczenie live" Width="610" Height="760" MinWidth="500" MinHeight="500" WindowStartupLocation="CenterScreen" Background="#F5F7FA">
 <DockPanel Margin="18">
  <StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="ErrorText" Foreground="#B02020" TextWrapping="Wrap"/><Button Content="Zapisz ustawienia tłumaczenia" Click="Save" Padding="12,8" Margin="0,12,0,0"/></StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="Źródła tłumaczenia" FontSize="18" FontWeight="SemiBold"/>
   <CheckBox x:Name="Output" Content="Dźwięk komputera — rozmówcy" Margin="0,10,0,6"/><CheckBox x:Name="Microphone" Content="Mikrofon"/>
   <TextBlock Text="Urządzenia wybierz i zapisz w głównych ustawieniach Recordera. Zmiana źródeł, modelu i folderu modeli działa od kolejnej sesji." TextWrapping="Wrap" Foreground="#566" Margin="0,8,0,14"/>
   <TextBlock Text="Skrót Start / Stop tłumaczenia" FontWeight="SemiBold"/>
   <StackPanel Orientation="Horizontal" Margin="0,8,0,16"><CheckBox x:Name="Ctrl" Content="Ctrl" Margin="0,0,12,0"/><CheckBox x:Name="Alt" Content="Alt" Margin="0,0,12,0"/><CheckBox x:Name="Shift" Content="Shift" Margin="0,0,12,0"/><CheckBox x:Name="Win" Content="Win" Margin="0,0,12,0"/><TextBox x:Name="Key" Width="65" MaxLength="12"/></StackPanel>
   <TextBlock Text="Wygląd okna napisów" FontSize="18" FontWeight="SemiBold"/>
   <TextBlock Text="Czcionka" Margin="0,8,0,4"/><ComboBox x:Name="FontBox" SelectionChanged="PreviewChanged"/>
   <TextBlock Text="Rozmiar czcionki (9–48)" Margin="0,8,0,4"/><Slider x:Name="FontSizeSlider" Minimum="9" Maximum="48" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="PreviewChanged"/>
   <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Kolor tekstu (#RRGGBB)"/><TextBox x:Name="TextColor" TextChanged="PreviewChanged" Margin="0,4,0,0"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="Kolor tła (#RRGGBB)"/><TextBox x:Name="BackgroundColor" TextChanged="PreviewChanged" Margin="0,4,0,0"/></StackPanel>
   </Grid>
   <TextBlock Text="Krycie tła (10–100%)"/><Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1" ValueChanged="PreviewChanged" Margin="0,4,0,8"/>
   <CheckBox x:Name="Original" Content="Pokazuj również angielski oryginał" Margin="0,4,0,12"/>
   <Border x:Name="PreviewSurface" Padding="14" CornerRadius="8"><TextBlock x:Name="PreviewText" Text="Jutro omówimy wyniki spotkania." TextWrapping="Wrap"/></Border>
   <TextBlock Text="Modele lokalne" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,8"/>
   <CheckBox x:Name="Turbo" Content="Turbo Q8 — większy model rozpoznawania" Margin="0,0,0,10"/>
   <DockPanel><Button DockPanel.Dock="Right" Content="Wybierz…" Click="Browse" Padding="8,4" Margin="8,0,0,0"/><TextBox x:Name="Models"/></DockPanel>
   <Button Content="Pobierz / sprawdź modele" Click="DownloadModels" Padding="8,6" Margin="0,10,0,0"/>
   <TextBlock Text="Folder zawierający modele Whisper, silero_vad.onnx i podfolder marian. Program sprawdza sumy kontrolne. Tłumaczenia i tekst źródłowy są zapisywane tylko lokalnie, bez wysyłania do RecoWilk. Samo tłumaczenie nie zapisuje audio." TextWrapping="Wrap" Foreground="#566" Margin="0,8,0,12"/>
  </StackPanel></ScrollViewer>
 </DockPanel>
</Window>
