<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <AssemblyName>MeetingAudioRecorder</AssemblyName>
    <RootNamespace>MeetingAudioRecorder.App</RootNamespace>
    <Version>1.2.3</Version>
    <Product>Meeting Audio Recorder</Product>
    <Company>MeetingAudioRecorder</Company>
    <Description>Nagrywanie mikrofonu i dźwięku ze słuchawek do MP3</Description>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeetingAudioRecorder.Core\MeetingAudioRecorder.Core.csproj" />
    <ProjectReference Include="..\MeetingAudioRecorder.Audio\MeetingAudioRecorder.Audio.csproj" />
    <ProjectReference Include="..\MeetingAudioRecorder.Infrastructure\MeetingAudioRecorder.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\browser-extension\manifest.json"
             Link="BrowserExtension\manifest.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\browser-extension\content.js"
             Link="BrowserExtension\content.js"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\browser-extension\service-worker.js"
             Link="BrowserExtension\service-worker.js"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\browser-extension\native-host-manifest.json"
             Link="meeting-organizer-native-host.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
