{
  "manifest_version": 3,
  "name": "Meeting Orgniazer Gemini",
  "description": "Przekazuje lokalnej aplikacji Meeting Audio Recorder kod aktywnego spotkania Google Meet.",
  "version": "1.0.0",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Meeting Orgniazer Gemini"
  }
}
