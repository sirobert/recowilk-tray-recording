<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MeetingAudioRecorder.BrowserBridge\MeetingAudioRecorder.BrowserBridge.csproj" />
    <ProjectReference Include="..\..\src\MeetingAudioRecorder.Core\MeetingAudioRecorder.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\src\MeetingAudioRecorder.App\Views\SettingsWindow.xaml"
          Link="UiContracts\SettingsWindow.xaml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\MeetingAudioRecorder.App\Views\RecordingsWindow.xaml"
          Link="UiContracts\RecordingsWindow.xaml"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\browser-extension\manifest.json"
          Link="BrowserExtension\manifest.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\browser-extension\native-host-manifest.json"
          Link="BrowserExtension\native-host-manifest.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\scripts\installer.iss"
          Link="Installer\installer.iss"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../src/MeetingAudioRecorder.TranslationWorker/CaptureIdleBoundary.cs" Link="Translation/CaptureIdleBoundary.cs" />
    <Compile Include="../../src/MeetingAudioRecorder.TranslationWorker/CaptureStartupRecovery.cs" Link="Translation/CaptureStartupRecovery.cs" />
    <Compile Include="../../src/MeetingAudioRecorder.TranslationWorker/ReplaySegmenter.cs" Link="Translation/ReplaySegmenter.cs" />
    <Compile Include="../../src/MeetingAudioRecorder.TranslationWorker/ReplayMailbox.cs" Link="Translation/ReplayMailbox.cs" />
    <Compile Include="../../src/MeetingAudioRecorder.TranslationWorker/LatestDraft.cs" Link="Translation/LatestDraft.cs" />
    <Compile Include="../../src/MeetingAudioRecorder.TranslationWorker/SampleRing.cs" Link="Translation/SampleRing.cs" />
    <Compile Include="../../src/MeetingAudioRecorder.TranslationWorker/SpeechTranslationInput.cs" Link="Translation/SpeechTranslationInput.cs" />
    <Compile Include="../../src/MeetingAudioRecorder.TranslationWorker/EnglishSentenceSplitter.cs" Link="Translation/EnglishSentenceSplitter.cs" />
  </ItemGroup>
</Project>
